rules_version = '2';

// Lumina Blocks Firestore rules.
//
// Three areas, not one. An earlier draft of the setup doc described only
// entitlements, which would have left the client free to write anything it
// liked into its own progress document. See review item R8 and DEC-0003.
//
// The server writes through the Admin SDK, which bypasses these rules entirely;
// everything below therefore describes what a *client* may do.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Entitlements are granted only by verifyPurchase after it has checked the
    // receipt against Play. A client that could write here could grant itself
    // every cosmetic in the catalogue.
    match /entitlements/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
    }

    // Purchase tokens carry the token -> uid binding that stops one purchase
    // from being replayed onto several accounts (DEC-0003). No client reads or
    // writes them: reading would leak another account's token, writing would
    // defeat the check.
    match /purchaseTokens/{token} {
      allow read, write: if false;
    }

    // Player progress is written from the device, so this is the one collection
    // a client may write - but only its own document, and only the fields the
    // client is supposed to own. Score and currency live here, so an
    // unrestricted write is a leaderboard and an economy handed to anyone with
    // the app installed.
    // Player progress, written from the device by
    // CloudPlayerProgressRepository. The document it actually sends is
    //
    //   { progress: <PlayerProgressState.toCloudJson()>, lastSyncUtc: <string> }
    //
    // and the model inside `progress` is snake_case. An earlier version of
    // these rules allowed a flat camelCase shape that no part of the app has
    // ever produced, so every real save was denied while the rules tests - which
    // used the same invented shape - passed. The fixture in
    // apps/mobile/test/fixtures is generated from the model so the two cannot
    // drift apart again.
    match /users/{uid} {
      function envelopeIsWellFormed() {
        return request.resource.data.keys().hasOnly(['progress', 'lastSyncUtc'])
               && request.resource.data.progress is map
               && request.resource.data.lastSyncUtc is string;
      }

      function progress() {
        return request.resource.data.progress;
      }

      // Entitlements record what the player paid for. They are granted by
      // verifyPurchase through the Admin SDK and live in entitlements/{uid},
      // which no client may write. They must arrive empty here, or a player
      // could grant themselves the catalogue with an ordinary score update.
      // See DEC-0003 and DEC-0008.
      function entitlementsAreEmpty() {
        return (!('economy_state' in progress())
                || !('owned_product_ids' in progress().economy_state)
                || progress().economy_state.owned_product_ids.size() == 0)
               && (!('cosmetics_state' in progress())
                || !('unlocked_skin_ids' in progress().cosmetics_state)
                || progress().cosmetics_state.unlocked_skin_ids.size() == 0);
      }

      // Cheap sanity checks on the values the app depends on. Not a schema
      // validator - rules are a poor place for one - but enough that a
      // corrupted or hostile client cannot store a negative best score or a
      // string where a number belongs.
      function scalarsAreSane() {
        return (!('schema_version' in progress())
                || (progress().schema_version is int
                    && progress().schema_version > 0))
               && (!('best_score' in progress())
                || (progress().best_score is int
                    && progress().best_score >= 0))
               && (!('streak_current_days' in progress())
                || (progress().streak_current_days is int
                    && progress().streak_current_days >= 0));
      }

      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
                            && envelopeIsWellFormed()
                            && entitlementsAreEmpty()
                            && scalarsAreSane();
      allow delete: if false;
    }

    // Anything not named above is closed. New collections have to be added
    // here deliberately rather than inheriting a permissive default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
